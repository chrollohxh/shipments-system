# ============================================================
#  ملفات لا تُرفع أبداً إلى Git — تحتوي بيانات شحنات حقيقية
#  (أسماء عملاء، سائقين، أرقام لوحات، إلخ) أو نسخاً احتياطية كاملة
#  للبيانات. لا شيء منها يلزم لعمل الموقع — index.html مستقل بذاته.
# ============================================================

# نسخ احتياطية كاملة من قاعدة البيانات
نسخة-احتياطية-*.json
*.json.bak

# ملفات PDF مرجعية — غالباً تحتوي بيانات شحنات حقيقية
*.pdf

# مساحة عمل المساعد المحلية — ليست جزءاً من المشروع المنشور
.claude/

# قالب Bootstrap مرجعي (Sneat) — للدراسة البصرية فقط، غير مستخدم في المشروع مباشرة
sneat-bootstrap-html-admin-template-free/

# ملفات نظام التشغيل
Thumbs.db
.DS_Store
